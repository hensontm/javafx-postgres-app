<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720" prefWidth="1280"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.demo.MasterDataController">

    <left>

        <VBox spacing="15"
              prefWidth="320"
              style="-fx-background-color:#F4F4F4;">

            <padding>
                <Insets top="25" left="20" right="20"/>
            </padding>

            <Label text="Form Customization">

                <font>
                    <Font size="24"/>
                </font>

            </Label>

            <Button text="← Back"
                    onAction="#goBack"
                    prefWidth="100"
                    style="-fx-background-color:#808B96;
               -fx-text-fill:white;"/>

            <Label text="Customization ID"/>
            <TextField/>

            <Label text="Customization Name"/>
            <TextField/>

            <Label text="Additional Price"/>
            <TextField/>

            <HBox spacing="10">

                <Button text="ADD"/>
                <Button text="UPDATE"/>
                <Button text="DELETE"/>

            </HBox>

        </VBox>

    </left>

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="20" left="20" right="20"/>
            </padding>

            <Label text="Customization List">

                <font>
                    <Font size="26"/>
                </font>

            </Label>

            <HBox spacing="10">

                <TextField HBox.hgrow="ALWAYS"
                           promptText="Search customization"/>

                <Button text="SEARCH"/>
                <Button text="RESET"/>

            </HBox>

            <TableView VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn text="ID" prefWidth="100"/>
                    <TableColumn text="Name" prefWidth="300"/>
                    <TableColumn text="Additional Price" prefWidth="200"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>