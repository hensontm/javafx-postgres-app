<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720" prefWidth="1280" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.MasterInventoryController">

    <left>
        <VBox prefWidth="320" spacing="15" style="-fx-background-color:#F4F4F4;">
            <padding>
                <Insets left="20" right="20" top="25" />
            </padding>

            <Label text="Form Inventory">
                <font>
                    <Font size="24" />
                </font>
            </Label>

            <Button onAction="#goBack" prefWidth="100" style="-fx-background-color:#808B96; -fx-text-fill:white;" text="← Back" />

            <Label text="Inventory ID" />
            <TextField fx:id="txtidInventory" promptText="ID Inventory" />

            <Label text="Branch ID" />
            <TextField fx:id="txtidBranch" promptText="ID Branch" />

            <Label text="Ingredient Name" />
            <TextField fx:id="txtnamaIngredient" promptText="Input ingredient name" />

            <Label text="Stock" />
            <TextField fx:id="txtStok" promptText="Input stock amount" />

            <Label text="Unit" />
            <TextField fx:id="txtUnit" promptText="e.g. Kg, Pcs, Liter" />

            <HBox spacing="10">
                <Button onAction="#onAddBtnClick" prefWidth="90" style="-fx-background-color:#2ECC71; -fx-text-fill:white;" text="ADD" />
                <Button onAction="#onUpdateBtnClick" prefWidth="90" style="-fx-background-color:#3498DB; -fx-text-fill:white;" text="UPDATE" />
                <Button onAction="#onDeleteBtnClick" prefWidth="90" style="-fx-background-color:#E74C3C; -fx-text-fill:white;" text="DELETE" />
            </HBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets left="20" right="20" top="20" />
            </padding>

            <Label text="Inventory List">
                <font>
                    <Font size="26" />
                </font>
            </Label>

            <HBox spacing="10">
                <TextField fx:id="txtCari" promptText="Search inventory" HBox.hgrow="ALWAYS" />
                <Button onAction="#onSearchBtnClick" text="SEARCH" />
                <Button onAction="#onResetBtnClick" text="RESET" />
            </HBox>

            <TableView fx:id="tabelInventory" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="204.5" text="ID" />
                    <TableColumn fx:id="colStock" prefWidth="236.0" text="Stock" />
                    <TableColumn fx:id="colIdMenu" prefWidth="222.0" text="Menu ID" />
                    <TableColumn fx:id="colIdBranch" prefWidth="256.5" text="Branch ID" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
