<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.MasterController">

   <center>
      <VBox alignment="CENTER" spacing="15">

         <Button fx:id="btn_employee" onAction="#goEmployee" prefHeight="45" prefWidth="250" text="Employee" />

         <Button fx:id="btn_branch" onAction="#goBranch" prefHeight="45" prefWidth="250" text="Branch" />

         <Button fx:id="btn_customer" onAction="#goCustomer" prefHeight="45" prefWidth="250" text="Customer" />

         <Button fx:id="btn_payment" onAction="#goPayment" prefHeight="45" prefWidth="250" text="Payment" />

         <Button fx:id="btn_customization" onAction="#goCustomization" prefHeight="45" prefWidth="250" text="Customization" />

         <Button fx:id="btn_menu" onAction="#goMenu" prefHeight="45" prefWidth="250" text="Menu" />

         <Button fx:id="btn_category" onAction="#goCategory" prefHeight="45" prefWidth="250" text="Category" />

      </VBox>
   </center>

   <bottom>
      <HBox alignment="CENTER_LEFT">
         <padding>
            <Insets bottom="25" left="25" />
         </padding>

         <Button fx:id="btn_back" onAction="#goBack" prefHeight="35" prefWidth="90" text="Back" />

      </HBox>
   </bottom>

</BorderPane>