<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720" prefWidth="1280" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.MasterMenuController">

    <left>
        <VBox prefWidth="320" spacing="15" style="-fx-background-color:#F4F4F4;">
            <padding>
                <Insets left="20" right="20" top="25" />
            </padding>

            <Label text="Form Menu">
                <font>
                    <Font size="24" />
                </font>
            </Label>

            <Button onAction="#goBack" prefWidth="100" style="-fx-background-color:#808B96; -fx-text-fill:white;" text="← Back" />

            <Label text="Menu ID" />
            <TextField fx:id="txtidMenu" promptText="ID Menu" />

            <Label text="Menu Name" />
            <TextField fx:id="txtnamaMenu" promptText="Input menu name" />

            <Label text="Price" />
            <TextField fx:id="txthargaMenu" promptText="Input price" />

            <Label text="Category ID" />
            <TextField fx:id="txtidCategory" promptText="ID Category" />

            <HBox spacing="10">
                <Button onAction="#onAddBtnClick" prefWidth="90" style="-fx-background-color:#2ECC71; -fx-text-fill:white;" text="ADD" />
                <Button onAction="#onUpdateBtnClick" prefWidth="90" style="-fx-background-color:#3498DB; -fx-text-fill:white;" text="UPDATE" />
                <Button onAction="#onDeleteBtnClick" prefWidth="90" style="-fx-background-color:#E74C3C; -fx-text-fill:white;" text="DELETE" />
            </HBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets left="20" right="20" top="20" />
            </padding>

            <Label text="Menu List">
                <font>
                    <Font size="26" />
                </font>
            </Label>

            <HBox spacing="10">
                <TextField fx:id="txtCari" promptText="Search menu name" HBox.hgrow="ALWAYS" />
                <Button onAction="#onSearchBtnClick" text="SEARCH" />
                <Button onAction="#onResetBtnClick" text="RESET" />
            </HBox>

            <TableView fx:id="tabelMenu" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="100" text="ID" />
                    <TableColumn fx:id="colName" prefWidth="363.0" text="Menu Name" />
                    <TableColumn fx:id="colPrice" prefWidth="239.0" text="Price" />
                    <TableColumn fx:id="colIdCategory" prefWidth="217.0" text="Category ID" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
