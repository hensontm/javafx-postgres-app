<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720" prefWidth="1280" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.ReportController">
    <top>
        <VBox spacing="5">
            <padding>
                <Insets left="40" top="25" />
            </padding>
            <Label text="Restaurant Analytics Dashboard">
                <font>
                    <Font size="32" />
                </font>
            </Label>
            <Label text="Business report and transaction insight">
                <font>
                    <Font size="15" />
                </font>
            </Label>
        </VBox>
    </top>

    <left>
        <VBox spacing="15">
            <padding>
                <Insets left="30" right="20" top="40" />
            </padding>
            <Button onAction="#transaksiTertinggiSepanjangMasa" prefWidth="220" text="🏆 Rekor Transaksi Terbesar" />
            <Button onAction="#transaksiTertinggiTiapTanggal" prefWidth="220" text="📅 Puncak Transaksi Harian" />
            <Button onAction="#transaksiCustomer" prefWidth="220" text="👤 Customer Aktif" />
            <Button onAction="#pendapatanCabang" prefWidth="220" text="🏢 Pendapatan Cabang" />
            <Button onAction="#menuPopuler" prefWidth="220" text="🍔 Menu Populer" />
            <Button onAction="#jamSibuk" prefWidth="220" text="⏰ Jam Sibuk" />
            <Button onAction="#goBack" prefWidth="220" text="← Back" />
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets right="30" />
            </padding>
            <Label fx:id="judulReport" text="Select Report">
                <font>
                    <Font size="25" />
                </font>
            </Label>
            <Label text="Result">
                <font>
                    <Font size="16" />
                </font>
            </Label>
            <TableView fx:id="tableReport" prefHeight="400" prefWidth="750" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="col1" prefWidth="400" text="Information" />
                    <TableColumn fx:id="col2" prefWidth="609.0" text="Value" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>