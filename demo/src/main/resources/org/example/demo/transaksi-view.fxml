<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.TransaksiController">

    <top>
        <VBox spacing="5.0">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <Label text="Form Kasir - Input Transaksi Baru">
                <font>
                    <Font name="System Bold" size="26.0" />
                </font>
            </Label>
            <Label text="Pilih menu, kustomisasi topping, dan simpan nota langsung ke database" textFill="#666666">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <HBox spacing="25.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" />
            </padding>

            <VBox prefWidth="450.0" spacing="15.0">

                <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="👤 Identitas Transaksi &amp; Pelanggan" />
                    <TextField fx:id="txtNamaCust" promptText="Nama Customer" />
                    <TextField fx:id="txtTelpCust" promptText="No. Telepon Customer" />
                    <TextField fx:id="txtEmailCust" promptText="Email Customer (Unique &amp; Not Null)" />
                    <HBox spacing="10.0">
                        <ComboBox fx:id="comboBranch" prefWidth="200.0" promptText="Pilih Cabang" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="comboEmployee" prefWidth="200.0" promptText="Pilih Karyawan" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox spacing="10.0">
                        <ComboBox fx:id="comboPayment" prefWidth="200.0" promptText="Metode Pembayaran" />
                        <TextField fx:id="txtDiskon" prefWidth="200.0" promptText="Diskon Toko (%)" />
                    </HBox>
                </VBox>

                <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="🍔 Pilihan Menu &amp; Topping" />
                    <HBox spacing="10.0">
                        <ComboBox fx:id="comboMenu" prefWidth="250.0" promptText="Pilih Menu" />
                        <TextField fx:id="txtQtyMenu" prefWidth="80.0" promptText="Qty" />
                    </HBox>

                    <Separator prefWidth="200.0" />

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <ComboBox fx:id="comboCustomization" prefWidth="200.0" promptText="Pilih Topping/Custom" />
                        <TextField fx:id="txtQtyCustom" prefWidth="100.0" promptText="Qty Topping" />
                        <Button onAction="#onTambahKustomisasiClick" style="-fx-background-color: #9C27B0; -fx-text-fill: white;" text="+ Topping" />
                    </HBox>

                    <TableView fx:id="tabelKustomisasiSementara" prefHeight="120.0">
                        <columns>
                            <TableColumn fx:id="colCustNameTemp" prefWidth="170.0" text="Topping" />
                            <TableColumn fx:id="colCustQtyTemp" prefWidth="70.0" text="Jumlah" />
                            <TableColumn fx:id="colCustPriceTemp" prefWidth="130.0" text="Total Harga" />
                        </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                    </TableView>

                    <Button maxWidth="Infinity" onAction="#onTambahKeKeranjangClick" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" text="📥 Masukkan ke Keranjang Utama" />
                </VBox>
            </VBox>

            <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="🛒 Keranjang Belanja Utama Nota" />
                    <TableView fx:id="tabelKeranjangUtama" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMenuNameCart" prefWidth="180.0" text="Nama Menu" />
                            <TableColumn fx:id="colMenuQtyCart" prefWidth="70.0" text="Qty" />
                            <TableColumn fx:id="colCustSummaryCart" prefWidth="274.0" text="Rincian Topping" />
                            <TableColumn fx:id="colTotalCart" prefWidth="150.5" text="Subtotal (Rp)" />
                        </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                    </TableView>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button onAction="#onHapusItemKeranjangClick" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="🗑️ Hapus Item Terpilih" />
                    <HBox alignment="CENTER_RIGHT" spacing="20.0" HBox.hgrow="ALWAYS">
                        <Label text="Total Bayar Final:">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotalBayar" text="Rp 0" textFill="#4CAF50">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                    </HBox>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="btn_back" onAction="#goBack" prefHeight="40.0" prefWidth="200.0" style="-fx-font-size: 13;" text="← Back ke Transaksi Home" />
                    <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                        <Button onAction="#onAddTransactionFinalClick" prefHeight="40.0" prefWidth="280.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;" text="💾 Simpan Transaksi Permanen" />
                    </HBox>
                </HBox>
            </VBox>

        </HBox>
    </center>
</BorderPane>
