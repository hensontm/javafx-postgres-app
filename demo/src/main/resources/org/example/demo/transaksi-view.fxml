<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.TransaksiController">

    <top>
        <VBox spacing="5.0">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <Label text="Form Kasir - Input Transaksi Baru">
                <font>
                    <Font name="System Bold" size="26.0" />
                </font>
            </Label>
            <Label text="Pilih menu, kustomisasi topping, dan simpan nota langsung ke database" textFill="#666666">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <HBox spacing="25.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" />
            </padding>

            <VBox prefWidth="450.0" spacing="15.0">

                <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                    <Label text="👤 Identitas Transaksi &amp; Pelanggan" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                    <TextField fx:id="txtNamaCust" promptText="Nama Customer" />
                    <TextField fx:id="txtTelpCust" promptText="No. Telepon Customer" />
                    <TextField fx:id="txtEmailCust" promptText="Email Customer (Unique &amp; Not Null)" />
                    <HBox spacing="10.0">
                        <ComboBox fx:id="comboBranch" promptText="Pilih Cabang" HBox.hgrow="ALWAYS" prefWidth="200.0" />
                        <ComboBox fx:id="comboEmployee" promptText="Pilih Karyawan" HBox.hgrow="ALWAYS" prefWidth="200.0" />
                    </HBox>
                    <HBox spacing="10.0">
                        <ComboBox fx:id="comboPayment" promptText="Metode Pembayaran" prefWidth="200.0" />
                        <TextField fx:id="txtDiskon" promptText="Diskon Toko (%)" prefWidth="200.0" />
                    </HBox>
                </VBox>

                <VBox spacing = "10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
                    <Label text="🍔 Pilihan Menu &amp; Topping" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                    <HBox spacing="10.0">
                        <ComboBox fx:id="comboMenu" promptText="Pilih Menu" prefWidth="250.0" />
                        <TextField fx:id="txtQtyMenu" promptText="Qty" prefWidth="80.0" />
                    </HBox>

                    <Separator prefWidth="200.0" />

                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <ComboBox fx:id="comboCustomization" promptText="Pilih Topping/Custom" prefWidth="200.0" />
                        <TextField fx:id="txtQtyCustom" promptText="Qty Topping" prefWidth="100.0" />
                        <Button onAction="#onTambahKustomisasiClick" text="+ Topping" style="-fx-background-color: #9C27B0; -fx-text-fill: white;" />
                    </HBox>

                    <TableView fx:id="tabelKustomisasiSementara" prefHeight="120.0">
                        <columns>
                            <TableColumn fx:id="colCustNameTemp" prefWidth="170.0" text="Topping" />
                            <TableColumn fx:id="colCustQtyTemp" prefWidth="70.0" text="Jumlah" />
                            <TableColumn fx:id="colCustPriceTemp" prefWidth="130.0" text="Total Harga" />
                        </columns>
                    </TableView>

                    <Button onAction="#onTambahKeKeranjangClick" text="📥 Masukkan ke Keranjang Utama" maxWidth="Infinity" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" />
                </VBox>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="15.0">
                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                    <Label text="🛒 Keranjang Belanja Utama Nota" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                    <TableView fx:id="tabelKeranjangUtama" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMenuNameCart" prefWidth="180.0" text="Nama Menu" />
                            <TableColumn fx:id="colMenuQtyCart" prefWidth="70.0" text="Qty" />
                            <TableColumn fx:id="colCustSummaryCart" prefWidth="280.0" text="Rincian Topping" />
                            <TableColumn fx:id="colTotalCart" prefWidth="140.0" text="Subtotal (Rp)" />
                        </columns>
                    </TableView>
                </VBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button onAction="#onHapusItemKeranjangClick" text="🗑️ Hapus Item Terpilih" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
                    <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="20.0">
                        <Label text="Total Bayar Final:">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotalBayar" text="Rp 0" textFill="#4CAF50">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                    </HBox>
                </HBox>

                <HBox spacing="15.0" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="btn_back" onAction="#goBack" text="← Back ke Transaksi Home" prefWidth="200.0" prefHeight="40.0" style="-fx-font-size: 13;" />
                    <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
                        <Button onAction="#onAddTransactionFinalClick" text="💾 Simpan Transaksi Permanen" prefWidth="280.0" prefHeight="40.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;" />
                    </HBox>
                </HBox>
            </VBox>

        </HBox>
    </center>
</BorderPane>